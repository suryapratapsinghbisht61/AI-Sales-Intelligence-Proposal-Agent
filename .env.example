# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://salespilot:salespilot@localhost:5432/salespilot
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Models: "provider:model" (LangChain init_chat_model / init_embeddings)
# Local & free:   CHAT_MODEL=ollama:llama3.2   EMBEDDING_MODEL=ollama:nomic-embed-text
# Hosted example: CHAT_MODEL=anthropic:claude-sonnet-5-5  FAST_MODEL=anthropic:claude-haiku-5-5
#                 EMBEDDING_MODEL=openai:text-embedding-3-small  (needs ANTHROPIC_API_KEY / OPENAI_API_KEY)
CHAT_MODEL=
FAST_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=768
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional cost estimate, USD per million tokens [input, output]
MODEL_PRICES=
ORG_MONTHLY_TOKEN_BUDGET=2000000

STORAGE_BACKEND=local
STORAGE_DIR=./data/uploads
# For S3/MinIO: STORAGE_BACKEND=s3, S3_BUCKET=..., S3_ENDPOINT_URL=..., AWS_ACCESS_KEY_ID=..., AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=
S3_ENDPOINT_URL=
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=60
